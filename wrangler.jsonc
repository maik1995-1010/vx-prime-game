{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vx-prime-game",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/game/ws*", "/game/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "GameRoom" }
    ]
  },
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "SUPABASE_URL": "https://damzsqtlbnfsqmqsezlt.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_HCMgJ__io6RHvOveihSTeQ_dtyVc9OX"
  }
}
